[Unit]
Description=Malformed-MCP puppeteer/browser MCP server (stdio, kept resident)
After=malformed-mcp.service
PartOf=malformed-mcp.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Malformed-MCP
# Chromium is vendored under the project by deploy.sh; point the server at it.
Environment=PLAYWRIGHT_BROWSERS_PATH=/root/Malformed-MCP/vendor/ms-playwright
ExecStart=/root/Malformed-MCP/scripts/mcp-stdio-run.sh /root/Malformed-MCP/runtime/fifos/puppeteer.fifo /root/Malformed-MCP/node_modules/.bin/mcp-server-puppeteer
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-puppeteer

[Install]
WantedBy=multi-user.target
